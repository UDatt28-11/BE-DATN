{
  "info": {
    "name": "PayOS API Test",
    "description": "Collection để test PayOS integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "checkout_url",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().success) {",
                  "    pm.environment.set('token', pm.response.json().data.token);",
                  "    console.log('Token saved:', pm.response.json().data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"your-password\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. PayOS Payment",
      "item": [
        {
          "name": "Create Payment Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().success) {",
                  "    const data = pm.response.json().data;",
                  "    if (data.orderCode) {",
                  "        pm.environment.set('order_code', data.orderCode.toString());",
                  "    }",
                  "    if (data.checkoutUrl) {",
                  "        pm.environment.set('checkout_url', data.checkoutUrl);",
                  "    }",
                  "    console.log('Payment link created:', data);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": 1,\n  \"amount\": 100000,\n  \"description\": \"Thanh toán đặt cọc đơn #BK001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/payos/create-payment-link",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "payos", "create-payment-link"]
            }
          }
        },
        {
          "name": "Check Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/payos/check-status/{{order_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "payos", "check-status", "{{order_code}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Webhook",
      "item": [
        {
          "name": "Test Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"00\",\n  \"desc\": \"Thành công\",\n  \"data\": {\n    \"orderCode\": {{order_code}},\n    \"amount\": 100000,\n    \"description\": \"Test payment\",\n    \"paymentLinkId\": \"1234567890\",\n    \"accountNumber\": \"1234567890\",\n    \"reference\": \"REF123456\",\n    \"transactionDateTime\": \"2024-01-16T10:30:00Z\",\n    \"currency\": \"VND\"\n  },\n  \"signature\": \"test_signature_here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/payos/webhook",
              "host": ["{{base_url}}"],
              "path": ["api", "payos", "webhook"]
            }
          }
        }
      ]
    }
  ]
}

